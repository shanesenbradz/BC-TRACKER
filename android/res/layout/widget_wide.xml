<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="horizontal" android:gravity="center_vertical" android:padding="14dp"
    android:background="@drawable/widget_bg_dark">
    <ImageView android:id="@+id/w_ring" android:layout_width="wrap_content" android:layout_height="match_parent"
        android:maxWidth="132dp" android:maxHeight="132dp" android:scaleType="fitCenter" android:adjustViewBounds="true"
        android:contentDescription="Fasting progress"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="14dp" android:orientation="vertical">
        <TextView android:id="@+id/w_caption" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="11sp" android:textStyle="bold" android:letterSpacing="0.06" android:textColor="#99EBEBF5"
            android:singleLine="true" android:ellipsize="end" android:text="FASTING"/>
        <TextView android:id="@+id/w_stage" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="17sp" android:textStyle="bold" android:textColor="#FFF5F5F7"
            android:singleLine="true" android:ellipsize="end" android:text="B.C Tracker"/>
        <Chronometer android:id="@+id/w_chrono" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textSize="14sp" android:textColor="#FFF5F5F7" android:fontFeatureSettings="tnum" android:singleLine="true"/>
        <ImageView android:id="@+id/w_bar" android:layout_width="match_parent" android:layout_height="18dp"
            android:layout_marginTop="8dp" android:scaleType="fitXY" android:contentDescription="Stage bar"/>
        <TextView android:id="@+id/w_next" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="5dp" android:textSize="11.5sp" android:textColor="#99EBEBF5"
            android:singleLine="true" android:ellipsize="end"/>
    </LinearLayout>
</LinearLayout>
